{
  "info": {
    "name": "NicaMarket - JWT Seccion 8 (reto: categorias por rol)",
    "description": "Ejecutar en orden (01 a 11). Los logins guardan los tokens. Antes de exportar, deja vacias adminToken y userToken.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "adminToken", "value": "" },
    { "key": "userToken", "value": "" },
    { "key": "nuevaCategoriaId", "value": "" }
  ],
  "item": [
    {
      "name": "01 Login ADMIN -> 200 + JWT",
      "request": {
        "auth": { "type": "noauth" },
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n    \"username\": \"admin\",\n    \"password\": \"Admin123!\"\n}", "options": { "raw": { "language": "json" } } },
        "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
      },
      "event": [
        { "listen": "test", "script": { "type": "text/javascript", "exec": [
          "pm.test('Status 200', () => pm.response.to.have.status(200));",
          "const body = pm.response.json();",
          "pm.test('Devuelve token Bearer', () => pm.expect(body.token).to.be.a('string').and.not.empty);",
          "pm.collectionVariables.set('adminToken', body.token);"
        ] } }
      ]
    },
    {
      "name": "02 Login USER (operador) -> 200 + JWT",
      "request": {
        "auth": { "type": "noauth" },
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n    \"username\": \"operador\",\n    \"password\": \"Operador123!\"\n}", "options": { "raw": { "language": "json" } } },
        "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
      },
      "event": [
        { "listen": "test", "script": { "type": "text/javascript", "exec": [
          "pm.test('Status 200', () => pm.response.to.have.status(200));",
          "const body = pm.response.json();",
          "pm.test('Devuelve token Bearer', () => pm.expect(body.token).to.be.a('string').and.not.empty);",
          "pm.collectionVariables.set('userToken', body.token);"
        ] } }
      ]
    },
    {
      "name": "03 [Evidencia 1] GET categorias SIN token -> 401",
      "request": {
        "auth": { "type": "noauth" },
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/categorias", "host": ["{{baseUrl}}"], "path": ["api", "categorias"] }
      },
      "event": [
        { "listen": "test", "script": { "type": "text/javascript", "exec": [
          "pm.test('Status 401 Unauthorized', () => pm.response.to.have.status(401));"
        ] } }
      ]
    },
    {
      "name": "04 GET categorias token MODIFICADO -> 401",
      "request": {
        "auth": { "type": "noauth" },
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}abc" }],
        "url": { "raw": "{{baseUrl}}/api/categorias", "host": ["{{baseUrl}}"], "path": ["api", "categorias"] }
      },
      "event": [
        { "listen": "test", "script": { "type": "text/javascript", "exec": [
          "pm.test('Status 401 Unauthorized', () => pm.response.to.have.status(401));"
        ] } }
      ]
    },
    {
      "name": "05 [Evidencia 2] GET categorias token USER -> 200",
      "request": {
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{userToken}}", "type": "string" }] },
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/categorias", "host": ["{{baseUrl}}"], "path": ["api", "categorias"] }
      },
      "event": [
        { "listen": "test", "script": { "type": "text/javascript", "exec": [
          "pm.test('Status 200', () => pm.response.to.have.status(200));",
          "pm.test('Devuelve una lista', () => pm.expect(pm.response.json()).to.be.an('array'));"
        ] } }
      ]
    },
    {
      "name": "06 [Evidencia 3] POST categorias token USER -> 403",
      "request": {
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{userToken}}", "type": "string" }] },
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n    \"nombre\": \"No debe crearse\",\n    \"activa\": true\n}", "options": { "raw": { "language": "json" } } },
        "url": { "raw": "{{baseUrl}}/api/categorias", "host": ["{{baseUrl}}"], "path": ["api", "categorias"] }
      },
      "event": [
        { "listen": "test", "script": { "type": "text/javascript", "exec": [
          "pm.test('Status 403 Forbidden', () => pm.response.to.have.status(403));"
        ] } }
      ]
    },
    {
      "name": "07 PUT categorias token USER -> 403",
      "request": {
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{userToken}}", "type": "string" }] },
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n    \"nombre\": \"No debe cambiar\",\n    \"activa\": true\n}", "options": { "raw": { "language": "json" } } },
        "url": { "raw": "{{baseUrl}}/api/categorias/1", "host": ["{{baseUrl}}"], "path": ["api", "categorias", "1"] }
      },
      "event": [
        { "listen": "test", "script": { "type": "text/javascript", "exec": [
          "pm.test('Status 403 Forbidden', () => pm.response.to.have.status(403));"
        ] } }
      ]
    },
    {
      "name": "08 DELETE categorias token USER -> 403",
      "request": {
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{userToken}}", "type": "string" }] },
        "method": "DELETE",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/categorias/1", "host": ["{{baseUrl}}"], "path": ["api", "categorias", "1"] }
      },
      "event": [
        { "listen": "test", "script": { "type": "text/javascript", "exec": [
          "pm.test('Status 403 Forbidden', () => pm.response.to.have.status(403));"
        ] } }
      ]
    },
    {
      "name": "09 [Evidencia 4] POST categorias token ADMIN -> 200",
      "request": {
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] },
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n    \"nombre\": \"Cat {{$timestamp}}\",\n    \"activa\": true\n}", "options": { "raw": { "language": "json" } } },
        "url": { "raw": "{{baseUrl}}/api/categorias", "host": ["{{baseUrl}}"], "path": ["api", "categorias"] }
      },
      "event": [
        { "listen": "test", "script": { "type": "text/javascript", "exec": [
          "pm.test('Status 200', () => pm.response.to.have.status(200));",
          "const body = pm.response.json();",
          "pm.test('Categoria creada con id', () => pm.expect(body.id).to.be.a('number'));",
          "pm.collectionVariables.set('nuevaCategoriaId', body.id);"
        ] } }
      ]
    },
    {
      "name": "10 PUT categorias token ADMIN -> 200",
      "request": {
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] },
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n    \"nombre\": \"Categoria actualizada\",\n    \"activa\": true\n}", "options": { "raw": { "language": "json" } } },
        "url": { "raw": "{{baseUrl}}/api/categorias/{{nuevaCategoriaId}}", "host": ["{{baseUrl}}"], "path": ["api", "categorias", "{{nuevaCategoriaId}}"] }
      },
      "event": [
        { "listen": "test", "script": { "type": "text/javascript", "exec": [
          "pm.test('Status 200', () => pm.response.to.have.status(200));",
          "pm.test('Nombre actualizado', () => pm.expect(pm.response.json().nombre).to.eql('Categoria actualizada'));"
        ] } }
      ]
    },
    {
      "name": "11 [Evidencia 5] DELETE categorias token ADMIN -> 204",
      "request": {
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] },
        "method": "DELETE",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/categorias/{{nuevaCategoriaId}}", "host": ["{{baseUrl}}"], "path": ["api", "categorias", "{{nuevaCategoriaId}}"] }
      },
      "event": [
        { "listen": "test", "script": { "type": "text/javascript", "exec": [
          "pm.test('Status 204 No Content', () => pm.response.to.have.status(204));"
        ] } }
      ]
    }
  ]
}
